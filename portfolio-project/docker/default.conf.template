server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Shows which VM / container answered (read by the page footer).
    location = /server-info {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"host":"${SERVED_BY}","container":"${CONTAINER_NAME}"}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # HOA playbooks: show .yml/.yaml as text in the browser instead of downloading.
    location ~* \.ya?ml$ {
        types { }
        default_type "text/plain; charset=utf-8";
    }

    location ~* \.(css|js|png|jpg|jpeg|gif|svg|webp|pdf)$ {
        expires 1h;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
